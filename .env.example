# ==============================================================================
#  MODÈLE DE CONFIGURATION — à copier en .env puis à adapter
#
#      cp .env.example .env
#      $EDITOR .env
#
#  .env est ignoré par git : il porte le nom de votre expérience SLICES et les
#  chemins de vos clés. Aucun identifiant du magasin d'objets ici — ceux-là vont
#  dans .env.secrets (voir README).
# ==============================================================================

# ------------------------------------------------------------------------------
# EXPÉRIENCE SLICES-RI
# ------------------------------------------------------------------------------
EXPERIMENT_NAME="deployk8s_slices"   # à personnaliser      # Nom de l'expérience (réservation)
SITE_ID="be-gent1-bi-vm1"               # Site SLICES (slices bi site list)
OS_IMAGE="Ubuntu 24.04.3"               # Image (slices bi diskimages list)
DURATION="3d"

# ------------------------------------------------------------------------------
# TOPOLOGIE DU CLUSTER KUBERNETES
# ------------------------------------------------------------------------------
# Gabarits disponibles sur be-gent1-bi-vm1 (slices bi --site-id <id> flavor list) :
#   tiny 1 vCPU/1 Gio | m1.small 1/2 | small 2/4 | medium 4/8 | large 4/16 | xlarge 8/32
MASTER_FLAVOR="medium"                  # Gabarit du nœud de contrôle   (4 vCPU / 8 Gio)
WORKER_FLAVOR="medium"                  # Gabarit des nœuds de travail  (4 vCPU / 8 Gio)

# WORKER_COUNT="auto" laisse le script choisir le nombre de workers en fonction
# de l'application demandée (profils ci-dessous). Mettre un nombre pour figer.
WORKER_COUNT="auto"
PROFILE_OTEL_WORKERS=3                  # otel-demo seul   (~9 Gio de RAM)
PROFILE_TT_WORKERS=7                    # 6 pour l'application + 1 réservé à la mesure
PROFILE_BOTH_WORKERS=9                  # les deux + 1 réservé à la mesure

# Le dernier worker est RÉSERVÉ à la mesure et interdit à l'application : il est
# marqué avant tout déploiement (voir OBS_DEDICATED_NODE plus bas et l'étape 2
# de PROCEDURE.md). Il ne faut donc pas le compter dans la capacité applicative.
#
# Pourquoi 6 pour l'application, et non 4. Le profil valait 4, dimensionné pour
# train-ticket SEUL.
# Depuis, la plateforme ajoute quatre charges que ce chiffre n'anticipait pas :
#   - la chaîne de mesure         Prometheus, Jaeger, kube-state-metrics, 2 collecteurs
#   - un nœud entier réservé      workers1 est interdit à l'application
#   - l'agent Java sur 46 services  ~150 Mio de tas supplémentaires chacun
#   - trois copies du consommateur  au lieu d'une
# Mesuré sur un cluster à 4 workers : après isolement il n'en restait que 3 pour
# 56 pods, saturés à 96-98 % de mémoire réservée. Un pod de Nacos ne trouvait
# plus de place, l'annuaire de services devenait incomplet, et les services qui
# s'y enregistrent tombaient en boucle — un manque de place qui se présente
# comme une panne applicative.

# ------------------------------------------------------------------------------
# APPLICATIONS À DÉPLOYER
# ------------------------------------------------------------------------------
# Valeur par défaut si --app n'est pas passé en ligne de commande.
# Valeurs acceptées : "otel-demo", "train-ticket", "both"
APPS="train-ticket"

# --- OpenTelemetry Demo -------------------------------------------------------
OTEL_NAMESPACE="otel-demo"              # Namespace Kubernetes
OTEL_RELEASE="my-otel-demo"             # Nom de la release Helm
OTEL_CHART_VERSION=""                   # Vide = dernière version du chart
OTEL_NODEPORT=30080                     # Port exposé sur les nœuds (30000-32767)

# --- Train Ticket -------------------------------------------------------------
TT_NAMESPACE="train-ticket"             # Namespace Kubernetes (distinct)
TT_REPO_URL="https://github.com/FudanSELab/train-ticket.git"
TT_REF="master"                         # Branche ou tag (ex. v1.0.0)
TT_DEPLOY_ARGS=""                       # "" = quick start (MySQL mutualisé)
                                        # "--independent-db"  : 1 MySQL par service
                                        # "--with-tracing"    : + SkyWalking
                                        # "--with-monitoring" : + Prometheus
                                        # "--all"             : tout (très lourd)
TT_UI_NODEPORT=32677                    # Fixé par les manifestes amont
TT_GATEWAY_NODEPORT=30467               # Fixé par les manifestes amont
TT_READY_TIMEOUT=1800                   # Attente max du démarrage (secondes)

# ------------------------------------------------------------------------------
# OUTILLAGE
# ------------------------------------------------------------------------------
KUBESPRAY_REF="master"                  # Branche ou tag de Kubespray
KUBESPRAY_METRICS_SERVER="true"         # Installe metrics-server (kubectl top)
ANSIBLE_FORKS=3                         # Hôtes contactés simultanément par Ansible.
                                        # Bas volontairement : une rafale de
                                        # connexions depuis une seule IP peut
                                        # être coupée par le pare-feu du site.
LOCAL_PATH_VERSION="v0.0.37"            # Provisionneur de stockage (secours)
HELM3_VERSION=""                        # Vide = dernière v3 (train-ticket)
HELM4_VERSION=""                        # Vide = dernière v4 (otel-demo)

# ------------------------------------------------------------------------------
# CONFIGURATION LOCALE (à adapter à ton poste)
# ------------------------------------------------------------------------------
# La paire de clés que le script recopie en 0600 avant de s'en servir, et dont
# il enregistre la partie publique sur chaque machine créée.
#
#   ssh-keygen -t ed25519 -f ~/.ssh/id_rsa -N ""
#
# La clé PRIVÉE n'a PAS de .pub. C'est la confusion la plus fréquente, et le
# script la refuse explicitement plutôt que d'échouer plus loin.
SSH_SOURCE_PRIV_KEY="/home/VOTRE_NOM/.ssh/id_rsa"
SSH_SOURCE_PUB_KEY="/home/VOTRE_NOM/.ssh/id_rsa.pub"
SLICES_VENV="$HOME/slices-venv"         # venv contenant la CLI slices
SSH_PRIV_KEY="$HOME/.ssh/id_rsa_slices" # Copie Linux de la clé (chmod 600)
INVENTORY_FILE="inventory.ini"          # Inventaire Ansible généré
REMOTE_WORKDIR="/home/ubuntu/autodeploy" # Dossier de travail sur le master
# ------------------------------------------------------------------------------
# PROFIL RÉSEAU
# ------------------------------------------------------------------------------
# "original" (défaut) : comportement réseau STRICTEMENT identique au script
#   initial, qui fonctionnait. Une temporisation puis UNE vérification SSH par
#   VM, options SSH minimales, aucune connexion persistante, et Kubespray tourne
#   avec sa propre configuration Ansible. Empreinte réseau la plus faible.
#
# "robust" : sondage SSH répété jusqu'à ce que chaque VM réponde, multiplexage
#   ControlMaster, parallélisme Ansible plafonné. Diagnostique mieux les VMs
#   lentes, mais ouvre bien plus de connexions et laisse des sockets ouverts —
#   ce qu'un pare-feu peut interpréter comme un balayage.
NETWORK_PROFILE="original"

# ------------------------------------------------------------------------------
# MODE D'ACCÈS AUX VMs
# ------------------------------------------------------------------------------
# false (défaut) : les VMs n'ont QU'UNE ADRESSE PRIVÉE et l'accès passe par le
#   jump host SSH de SLICES (bastion). C'est le chemin documenté par SLICES,
#   et il n'expose aucune machine sur Internet — donc plus aucun filtrage du
#   trafic entrant vers les adresses publiques. Le jump host est découvert
#   automatiquement dans l'inventaire généré par la CLI.
#   Contrepartie : les interfaces web s'atteignent par un tunnel SSH
#   (voir la section « Accès aux interfaces web » du README).
#
# true : les VMs reçoivent une IPv4 publique, joignables directement. Pratique
#   pour ouvrir les NodePorts au navigateur, mais expose les services et dépend
#   du filtrage réseau du site.
USE_PUBLIC_IPV4="false"
INITIAL_SLEEP=20                        # Temporisation avant vérification (profil original)

# Réglages du profil "robust" uniquement
SSH_WAIT_TIMEOUT=900                    # Attente max du démarrage SSH par VM (s)
SSH_INITIAL_DELAY=60                    # Délai avant le 1er test SSH (s) : aucune
                                        # VM ne démarre plus vite, autant ne pas
                                        # frapper dans le vide.
SSH_POLL_INTERVAL=20                    # Intervalle entre 2 tests SSH (s). Ne pas
                                        # descendre : un sondage rapide ressemble
                                        # à un scan et peut faire blackholer ton IP.

# ------------------------------------------------------------------------------
# NŒUD DÉDIÉ À LA MESURE
# ------------------------------------------------------------------------------
# Le nœud qui portera Prometheus, Jaeger et la passerelle. Il est marqué AVANT
# le déploiement de l'application (« observability.sh reserve »), de sorte que
# celle-ci ne s'y installe jamais. Sans cette réservation préalable, l'isolement
# ultérieur laisse des volumes applicatifs coincés dessus : ils ne peuvent plus
# être déplacés, un volume local-path étant attaché à sa machine.
#
# C'est le DERNIER worker, celui ajouté au profil au-delà de la capacité
# applicative. Avec PROFILE_TT_WORKERS=7, les workers 0 à 5 portent
# l'application et workers6 la mesure.
OBS_DEDICATED_NODE="workers6"
